# Public browser configuration only. The anon/publishable key is designed to be
# visible in the static bundle; protect every table with RLS.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# GitHub Pages project-site prefix (e.g. /tend/); use / for a custom domain.
VITE_BASE_PATH=/
